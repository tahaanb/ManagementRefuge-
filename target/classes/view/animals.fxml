<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>


<VBox spacing="20" styleClass="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.refuge.controller.AnimalController" prefHeight="700.0" prefWidth="1100.0">

<padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

<Label text="🐾 Refuge Harmony : Gestion des Coeurs" styleClass="main-title"/>

<HBox spacing="25" VBox.vgrow="ALWAYS">
    <VBox HBox.hgrow="ALWAYS" spacing="15">
        <TableView fx:id="animalTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="photoColumn" text="Aperçu" prefWidth="80" resizable="false"/>
                <TableColumn fx:id="nomColumn" text="Nom du Petit" prefWidth="150"/>
                <TableColumn fx:id="especeColumn" text="Espèce" prefWidth="120"/>
                <TableColumn fx:id="statutColumn" text="Statut actuel" prefWidth="130"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        </TableView>
    </VBox>

    <VBox spacing="15" styleClass="form-card" prefWidth="400">
        <Label text="👤 Profil de l'Animal" style="-fx-font-size: 20; -fx-text-fill: #2d3436; -fx-font-weight: bold;"/>

        <StackPane alignment="CENTER" style="-fx-background-color: #f7f1e3; -fx-background-radius: 15; -fx-border-color: #d1ccc0; -fx-border-radius: 15; -fx-border-style: dashed;">
            <ImageView fx:id="previewImage" fitHeight="150" fitWidth="150" pickOnBounds="true" preserveRatio="true" />
            <Button text="📷" onAction="#choisirPhoto" styleClass="btn-adopt" StackPane.alignment="BOTTOM_RIGHT">
                <StackPane.margin><Insets bottom="10" right="10"/></StackPane.margin>
            </Button>
        </StackPane>

        <GridPane hgap="10" vgap="10">
            <TextField fx:id="nomField" promptText="Nom" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="especeField" promptText="Espèce" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <TextField fx:id="raceField" promptText="Race" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="ageField" promptText="Âge" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>

        <ComboBox fx:id="statutCombo" promptText="Statut" maxWidth="Infinity"/>

        <Separator/>

        <Label text="🤝 Espace Adoption" style="-fx-font-weight: bold; -fx-text-fill: #fd79a8;"/>
        <HBox spacing="10">
            <ComboBox fx:id="adoptantCombo" promptText="Choisir un Adoptant" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="adoptBtn" text="Adopter !" onAction="#adopterAnimal" styleClass="btn-adopt"/>
        </HBox>

        <Separator/>

        <VBox spacing="8">
            <Button text="➕ Nouveau Pensionnaire" onAction="#ajouterAnimal" maxWidth="Infinity" styleClass="btn-success" prefHeight="40"/>
            <HBox spacing="10">
                <Button text="💾 Sauver" onAction="#modifierAnimal" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-warning"/>
                <Button text="❌ Supprimer" onAction="#supprimerAnimal" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-danger"/>
            </HBox>
            <Button fx:id="ficheSanteBtn" text="📋 Dossier Médical Complet" onAction="#ouvrirFicheSante" maxWidth="Infinity" styleClass="btn-info" />
        </VBox>
    </VBox>
</HBox>
</VBox>
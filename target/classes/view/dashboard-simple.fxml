<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="dashboard-container"
            stylesheets="@dashboard.css"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ma.refuge.controller.DashboardController">

    <VBox spacing="30" styleClass="dashboard-content" style="-fx-padding: 40;">

        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox>
                <Label text="🐾 Refuge Dashboard" styleClass="dashboard-title"/>
                <Label text="Bienvenue ! Voici l'état actuel de votre refuge." style="-fx-text-fill: #747d8c; -fx-font-size: 14px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="lastUpdated" styleClass="last-updated" text="Mis à jour : --:--" />
                <Button text="🔄 Actualiser" onAction="#refreshData" styleClass="btn-refresh"
                        style="-fx-background-radius: 20; -fx-background-color: white; -fx-border-color: #dfe4ea; -fx-border-radius: 20; -fx-cursor: hand;"/>


            </VBox>
        </HBox>

        <FlowPane hgap="25" vgap="25" alignment="CENTER">
            <VBox styleClass="stat-card, card-animals">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="🐶" style="-fx-font-size: 30;"/>
                    <VBox>
                        <Label text="ANIMAUX" styleClass="stat-title"/>
                        <Label fx:id="animalCount" text="0" styleClass="stat-value"/>
                    </VBox>
                </HBox>
                <Label fx:id="adoptedCount" text="0 Adoptés" styleClass="stat-subtitle"/>
            </VBox>

            <VBox styleClass="stat-card, card-adoptants">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="🤝" style="-fx-font-size: 30;"/>
                    <VBox>
                        <Label text="ADOPTANTS" styleClass="stat-title"/>
                        <Label fx:id="adoptantCount" text="0" styleClass="stat-value"/>
                    </VBox>
                </HBox>
                <Label fx:id="activeAdoptants" text="0 actifs" styleClass="stat-subtitle"/>
            </VBox>

            <VBox styleClass="stat-card, card-health">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="🩺" style="-fx-font-size: 30;"/>
                    <VBox>
                        <Label text="SANTÉ" styleClass="stat-title"/>
                        <Label fx:id="ficheSanteCount" text="0" styleClass="stat-value"/>
                    </VBox>
                </HBox>
                <Label fx:id="urgentFiches" text="0 Urgences" styleClass="stat-subtitle"
                       style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 5;"/>
            </VBox>

            <VBox styleClass="stat-card, card-rate">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="📈" style="-fx-font-size: 30;"/>
                    <VBox>
                        <Label text="TAUX" styleClass="stat-title"/>
                        <Label fx:id="adoptionRate" text="0%" styleClass="stat-value"/>
                    </VBox>
                </HBox>
                <Label fx:id="avgAdoptionTime" text="Moy. 0 jours" styleClass="stat-subtitle"/>
            </VBox>
        </FlowPane>

        <HBox spacing="30" VBox.vgrow="ALWAYS">
            <VBox styleClass="chart-container" HBox.hgrow="ALWAYS">
                <Label text="📊 Analyse des Adoptions" styleClass="section-title" style="-fx-font-weight: bold; -fx-font-size: 18;"/>
                <AreaChart fx:id="adoptionChart" styleClass="chart"
                           legendVisible="false"  animated="true"
                           VBox.vgrow="ALWAYS">
                    <xAxis><CategoryAxis side="BOTTOM" tickLabelFill="#636e72" /></xAxis>
                    <yAxis><NumberAxis side="LEFT" tickLabelFill="#636e72" /></yAxis>
                </AreaChart>
            </VBox>

            <VBox spacing="15" prefWidth="480">
                <Label text="🔔 Activités Récentes" styleClass="section-title" style="-fx-font-weight: bold; -fx-font-size: 18;"/>
                <TableView fx:id="recentActivityTable" VBox.vgrow="ALWAYS" styleClass="activity-table">
                    <columns>
                        <TableColumn fx:id="dateCol" text="Date" prefWidth="100" />
                        <TableColumn fx:id="actionCol" text="Action" prefWidth="130" />
                        <TableColumn fx:id="descCol" text="Détails" prefWidth="240" />
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
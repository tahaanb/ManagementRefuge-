<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="ma.refuge.controller.FicheSanteController"
      spacing="10" 
      style="-fx-padding: 10;"
      stylesheets="@style.css">

    <!-- En-tête avec les informations de l'animal -->
    <HBox spacing="20" style="-fx-padding: 10; -fx-background-color: #f0f0f0; -fx-background-radius: 5;">
        <ImageView fx:id="animalImageView" 
                   fitWidth="100" 
                   fitHeight="100" 
                   preserveRatio="true"
                   style="-fx-border-color: #ccc; -fx-border-width: 1px;">
            <image>
                <Image url="@../images/default-animal.png" />
            </image>
        </ImageView>
        
        <VBox spacing="5">
            <HBox spacing="5">
                <Label text="Nom: " style="-fx-font-weight: bold;" />
                <Label fx:id="animalNomLabel" />
            </HBox>
            <HBox spacing="5">
                <Label text="Espèce: " style="-fx-font-weight: bold;" />
                <Label fx:id="animalEspeceLabel" />
            </HBox>
            <HBox spacing="5">
                <Label text="Âge: " style="-fx-font-weight: bold;" />
                <Label fx:id="animalAgeLabel" />
            </HBox>
        </VBox>
    </HBox>

    <SplitPane dividerPositions="0.4" style="-fx-padding: 10 0 0 0;">
        <!-- Panneau de gauche : Formulaire -->
        <VBox spacing="10" style="-fx-padding: 0 10 0 0;">
            <Label text="Nouvelle entrée de santé" style="-fx-font-size: 1.2em; -fx-font-weight: bold;" />
            
            <GridPane hgap="10" vgap="10">
                <Label text="Type: " GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ComboBox fx:id="typeCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Date: " GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="Vétérinaire: " GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="veterinaireField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="Diagnostic: " GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <TextArea fx:id="diagnosticArea" GridPane.columnIndex="1" GridPane.rowIndex="3" 
                         prefRowCount="3" wrapText="true" />
                
                <Label text="Traitement: " GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextArea fx:id="traitementArea" GridPane.columnIndex="1" GridPane.rowIndex="4" 
                         prefRowCount="3" wrapText="true" />
                
                <Label text="Observations: " GridPane.columnIndex="0" GridPane.rowIndex="5" />
                <TextArea fx:id="observationsArea" GridPane.columnIndex="1" GridPane.rowIndex="5" 
                         prefRowCount="2" wrapText="true" />
                
                <Label text="Prochain rappel: " GridPane.columnIndex="0" GridPane.rowIndex="6" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="6">
                    <DatePicker fx:id="prochainRappelPicker" />
                    <Label text="(facultatif)" style="-fx-text-fill: #666;" />
                </HBox>
                
                <Label text="Notes importantes: " GridPane.columnIndex="0" GridPane.rowIndex="7" />
                <TextArea fx:id="notesImportantesArea" GridPane.columnIndex="1" GridPane.rowIndex="7" 
                         prefRowCount="2" wrapText="true" />
                
                <Label text="Document: " GridPane.columnIndex="0" GridPane.rowIndex="8" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="8">
                    <TextField fx:id="documentPathField" />
                    <Button text="Parcourir..." onAction="#handleParcourirFichier" />
                </HBox>
            </GridPane>
            
            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                <Button text="Nouveau" onAction="#handleNouvelleFiche" />
                <Button text="Enregistrer" onAction="#handleEnregistrer" defaultButton="true" />
                <Button text="Supprimer" onAction="#handleSupprimer" style="-fx-text-fill: #d32f2f;" />
            </HBox>
        </VBox>
        
        <!-- Panneau de droite : Historique -->
        <VBox spacing="10">
            <Label text="Historique des soins" style="-fx-font-size: 1.2em; -fx-font-weight: bold;" />
            <TableView fx:id="fichesTable" style="-fx-pref-height: 500;">
                <columns>
                    <TableColumn fx:id="dateCol" text="Date" prefWidth="100" />
                    <TableColumn fx:id="typeCol" text="Type" prefWidth="120" />
                    <TableColumn fx:id="veterinaireCol" text="Vétérinaire" prefWidth="150" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>
    
</VBox>

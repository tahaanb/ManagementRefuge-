<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="15"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.refuge.controller.AnimalController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestion des Animaux" styleClass="title"/>

    <TableView fx:id="animalTable">
        <columns>
            <TableColumn fx:id="nomColumn" text="Nom"/>
            <TableColumn fx:id="especeColumn" text="Espèce"/>
            <TableColumn fx:id="raceColumn" text="Race"/>
            <TableColumn fx:id="ageColumn" text="Âge"/>
            <TableColumn fx:id="statutColumn" text="Statut"/>
            <TableColumn fx:id="adoptantColumn" text="Adoptant"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <TextField fx:id="nomField" promptText="Nom"/>
        <TextField fx:id="especeField" promptText="Espèce"/>
        <TextField fx:id="raceField" promptText="Race"/>
        <TextField fx:id="ageField" promptText="Âge"/>
        <ComboBox fx:id="statutCombo"/>
        <ComboBox fx:id="adoptantCombo" promptText="Sélectionner Adoptant"/>
    </HBox>

    <HBox spacing="10">
        <Button text="Ajouter" styleClass="btn-success" onAction="#ajouterAnimal"/>
        <Button text="Modifier" styleClass="btn-warning" onAction="#modifierAnimal"/>
        <Button text="Supprimer" styleClass="btn-danger" onAction="#supprimerAnimal"/>
        <Button text="Adopter" styleClass="btn-primary" onAction="#adopterAnimal"/>
    </HBox>
</VBox>
